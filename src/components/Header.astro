---
import { copy, paths, type Locale } from '../lib/copy';

interface Props {
  locale: Locale;
  alternatePaths: { es: string; en: string };
  isHome?: boolean;
}

const { locale, alternatePaths, isHome = false } = Astro.props;
const t = copy[locale];
const otherLocale = locale === 'es' ? 'en' : 'es';
const base = paths[locale].home;
const links = [
  { href: `${base}#inicio`, label: t.nav.home },
  { href: `${base}#servicios`, label: t.nav.services },
  { href: `${base}#proyectos`, label: t.nav.work },
  { href: `${base}#historia`, label: t.nav.story },
  { href: `${base}#contacto`, label: t.nav.contact },
];
---

<header class="site-header" data-home-page={isHome ? 'true' : undefined}>
  <div class="header-inner shell">
    <a class="brand" href={base} aria-label="Juana & Lola Digital">
      <img src="/brand-mark.webp" width="42" height="42" alt="" />
      <span>Juana <span class="brand-amp">&</span> Lola <small>Digital</small></span>
    </a>

    <nav class="desktop-nav" aria-label={locale === 'es' ? 'Navegación principal' : 'Main navigation'}>
      {links.map((link) => (
        <a class:list={{ 'nav-contact': link.label === t.nav.contact }} href={link.href} data-nav-section={link.href.split('#')[1]}>
          {link.label}
          {link.label === t.nav.contact && <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>}
        </a>
      ))}
    </nav>

    <a class="lang-switch desktop-lang" href={alternatePaths[otherLocale]} hreflang={otherLocale} lang={otherLocale} aria-label={t.switchLabel} data-language-switch>
      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.4" /><ellipse cx="10" cy="10" rx="3" ry="7" stroke="currentColor" stroke-width="1.4" /><path d="M3 10h14" stroke="currentColor" stroke-width="1.4" /></svg>
      {otherLocale.toUpperCase()}
    </a>

    <details class="mobile-nav">
      <summary aria-label={t.nav.menu} aria-controls="mobile-navigation">
        <span class="mobile-menu-label">{t.nav.menu}</span>
        <span class="menu-glyph" aria-hidden="true"><i></i><i></i></span>
      </summary>
      <nav id="mobile-navigation" aria-label={locale === 'es' ? 'Navegación móvil' : 'Mobile navigation'}>
        {links.map((link) => (
          <a class:list={{ 'nav-contact': link.label === t.nav.contact }} href={link.href} data-nav-section={link.href.split('#')[1]}>
            {link.label}
            {link.label === t.nav.contact && <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>}
          </a>
        ))}
        <a class="lang-switch mobile-language" href={alternatePaths[otherLocale]} hreflang={otherLocale} lang={otherLocale} aria-label={t.switchLabel} data-language-switch>
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.4" /><ellipse cx="10" cy="10" rx="3" ry="7" stroke="currentColor" stroke-width="1.4" /><path d="M3 10h14" stroke="currentColor" stroke-width="1.4" /></svg>
          {otherLocale.toUpperCase()}
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  const homeHeader = document.querySelector<HTMLElement>('.site-header[data-home-page="true"]');
  if (homeHeader) {
    const sections = Array.from(document.querySelectorAll<HTMLElement>('#main-content > section[id]'));
    const languageLinks = Array.from(homeHeader.querySelectorAll<HTMLAnchorElement>('[data-language-switch]'));
    const destinations = languageLinks.map((link) => ({ link, base: link.getAttribute('href') ?? '' }));
    const navigationLinks = Array.from(homeHeader.querySelectorAll<HTMLAnchorElement>('[data-nav-section]'));

    if (sections.length) {
      const updateLanguageLinks = () => {
        const headerHeight = homeHeader.getBoundingClientRect().height;
        const centerY = headerHeight + Math.max(0, window.innerHeight - headerHeight) / 2;
        const readingY = headerHeight + Math.min(160, Math.max(0, window.innerHeight - headerHeight) / 4);
        let visibleSection = sections[0];
        let currentSection = sections[0];

        for (const section of sections) {
          const top = section.getBoundingClientRect().top;
          if (top <= centerY) visibleSection = section;
          if (top <= readingY) currentSection = section;
        }

        const currentId = currentSection.id === 'proceso' ? 'servicios' : currentSection.id;
        for (const link of navigationLinks) {
          if (link.dataset.navSection === currentId) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
        for (const { link, base } of destinations) {
          link.href = `${base}#${visibleSection.id}`;
        }
      };

      let updateScheduled = false;
      const scheduleUpdate = () => {
        if (updateScheduled) return;
        updateScheduled = true;
        requestAnimationFrame(() => {
          updateScheduled = false;
          updateLanguageLinks();
        });
      };

      window.addEventListener('scroll', scheduleUpdate, { passive: true });
      window.addEventListener('resize', scheduleUpdate);
      window.addEventListener('load', updateLanguageLinks, { once: true });
      languageLinks.forEach((link) => link.addEventListener('click', updateLanguageLinks));
      updateLanguageLinks();
    }
  }

  document.querySelectorAll<HTMLDetailsElement>('.mobile-nav').forEach((menu) => {
    const toggle = menu.querySelector('summary');
    const closeMenu = (restoreFocus = false) => {
      if (!menu.open) return;
      menu.open = false;
      if (restoreFocus) toggle?.focus({ preventScroll: true });
    };

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        // Let the anchor navigate before hiding its containing disclosure.
        requestAnimationFrame(() => closeMenu(true));
      });
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu(true);
    });
    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) closeMenu();
    });
    menu.addEventListener('focusout', () => {
      // Focus moves through the body between blur and focusin.
      setTimeout(() => {
        if (!menu.contains(document.activeElement)) closeMenu();
      }, 0);
    });
    window.matchMedia('(min-width: 851px)').addEventListener('change', () => closeMenu());
  });
</script>
