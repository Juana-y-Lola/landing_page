---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, paths, type Locale } from '../lib/copy';
import { getProjects } from '../lib/portfolio';
import { petPhotos } from '../lib/pets';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const projects = await getProjects(locale);
const allConcepts = projects.every((project) => project.data.kind === 'concept');
const hasConcepts = projects.some((project) => project.data.kind === 'concept');
const contactEmail = 'hola@juanaylola.com';
---

<BaseLayout locale={locale} title={t.title} description={t.description} canonicalPath={paths[locale].home} alternatePaths={{ es: '/', en: '/en/' }} isHome useJakarta>
  <main id="main-content">
    <section class="hero section-pad" id="inicio">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <div class="hero-heading">
            <div class="hero-meta">
              <p class="hero-services">{t.hero.eyebrow}</p>
              <p class="hero-location">{t.hero.location}</p>
            </div>
            <h1><span>{t.hero.before}</span> <em>{t.hero.highlight}</em></h1>
          </div>
          <p class="hero-lead">{t.hero.body}</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#contacto">{t.hero.primary}<span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#servicios">{t.hero.secondary}<span aria-hidden="true">↘</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="services section-pad" id="servicios">
      <div class="shell">
        <div class="section-heading services-heading">
          <p class="eyebrow light section-label">{t.services.eyebrow}</p>
          <h2>{t.services.title}</h2>
          <p>{t.services.intro}</p>
        </div>
        <div class="service-grid">
          {t.services.items.map((item) => (
            <article class="service-card">
              <div class="service-card-top"><span>{item.number} / 04</span></div>
              <h3>{item.title}</h3>
              {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="process section-pad" id="proceso">
      <div class="shell process-grid">
        <div class="process-heading">
          <p class="eyebrow section-label">{t.process.eyebrow}</p>
          <h2>{t.process.title}</h2>
        </div>
        <div class="process-track">
          <ol class="process-steps" role="list">
            {t.process.items.map((item) => (
              <li class="process-step"><span aria-hidden="true">{item.number}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="work section-pad" id="proyectos">
      <div class="shell">
        <div class="section-heading work-heading">
          <p class="eyebrow section-label">{t.work.eyebrow}</p>
          <h2>{t.work.title}</h2>
          <p>{allConcepts ? t.work.intro : hasConcepts ? t.work.introMixed : t.work.introReal}</p>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <a class="project-image-link" href={project.data.detailLink} aria-label={`${project.data.kind === 'concept' ? t.work.view : t.work.viewReal}: ${project.data.name}`}>
                <img src={project.data.previewImage} width="1200" height="800" alt={project.data.imageAlt} loading="lazy" />
              </a>
              <div class="project-meta"><span>{project.data.category}</span><span>{project.data.kind === 'concept' ? t.work.concept : t.work.real}</span></div>
              <h3><a href={project.data.detailLink}>{project.data.name}</a></h3>
              <p>{project.data.description}</p>
              <div class="project-links">
                <a class="text-link project-primary-link" href={project.data.detailLink}>{project.data.kind === 'concept' ? t.work.view : t.work.viewReal}<span aria-hidden="true">↗</span></a>
                {project.data.projectLink && <a class="text-link" href={project.data.projectLink} target="_blank" rel="noopener noreferrer">{t.work.visitSite}<span aria-hidden="true">↗</span></a>}
                {project.data.repositoryLink && <a class="text-link" href={project.data.repositoryLink} target="_blank" rel="noopener noreferrer">GitHub<span aria-hidden="true">↗</span></a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="story section-pad" id="historia">
      <div class="shell story-grid">
        <div class="story-copy">
          <p class="eyebrow light section-label">{t.story.eyebrow}</p>
          <h2>{t.story.title}</h2>
          <p>{t.story.text1}</p>
          <p>{t.story.text2}</p>
          <p>{t.story.text3}</p>
        </div>
        <div class="cat-gallery">
          {t.story.names.map((name, index) => (
            <figure class:list={['cat-card', `cat-card-${index + 1}`]}>
              <div class="cat-placeholder">
                {petPhotos[index] ? (
                  <img src={petPhotos[index] ?? undefined} alt={`${locale === 'es' ? 'Foto de' : 'Photo of'} ${name}`} loading="lazy" />
                ) : (
                  <><svg viewBox="0 0 140 150" fill="none" aria-hidden="true"><path d="M24 70 28 19 55 42c10-5 20-5 30 0l27-23 4 51c7 10 10 21 10 33 0 28-25 44-56 44s-56-16-56-44c0-12 3-23 10-33Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M48 92c4-4 10-4 14 0m16 0c4-4 10-4 14 0M67 105l3 3 3-3m-3 3v7m0 0c-4 4-8 5-13 2m13-2c4 4 8 5 13 2M37 109l-23-5m23 13-22 2m88-10 23-5m-23 13 22 2" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{t.story.photoSoon}</span></>
                )}
              </div>
              <figcaption>{name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="contact section-pad" id="contacto">
      <div class="shell contact-grid">
        <div class="contact-copy">
          <p class="eyebrow section-label">{t.contact.eyebrow}</p>
          <h2>{t.contact.title}</h2>
          <p>{t.contact.intro}</p>
          <ul class="contact-benefits">
            {t.contact.benefits.map((benefit) => <li>{benefit}</li>)}
          </ul>
          <a class="contact-email-card" href={`mailto:${contactEmail}`}>
            <span class="contact-email-label">EMAIL</span>
            <span class="contact-email-address">{contactEmail}</span>
            <svg class="contact-email-arrow" viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </div>
        <form class="contact-form" name="contact" method="POST" action={paths[locale].thanks} data-netlify="true" netlify-honeypot="bot-field" data-locale={locale} data-sending-label={t.contact.sending}>
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="language" value={locale} />
          <p class="visually-hidden" aria-hidden="true"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <div class="form-row">
            <label><span class="field-label">{t.contact.name}</span><input name="name" type="text" autocomplete="name" placeholder={t.contact.namePlaceholder} required /></label>
            <label><span class="field-label">{t.contact.email}</span><input name="email" type="email" autocomplete="email" placeholder={t.contact.emailPlaceholder} required /></label>
          </div>
          <label><span class="field-label">{t.contact.service}</span>
            <select name="service" required>
              <option value="" disabled selected>{t.contact.servicePlaceholder}</option>
              {t.contact.serviceOptions.map((option, index) => <option value={['free-consultation', 'website', 'seo', 'custom-software', 'it-consulting', 'unsure'][index]}>{option}</option>)}
            </select>
          </label>
          <label><span class="field-label">{t.contact.message}</span><textarea name="message" rows="5" placeholder={t.contact.messagePlaceholder} required></textarea></label>
          <div class="form-bottom"><p>{t.contact.note} <a class="form-privacy-link" href={paths[locale].privacy}>{t.contact.privacyLink}</a>.</p><button class="button button-dark" type="submit"><span class="submit-label">{t.contact.submit}</span><span aria-hidden="true">↗</span></button></div>
          <p class="form-error" role="alert" hidden>{t.contact.error}</p>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const serviceCards = [...document.querySelectorAll<HTMLElement>('.service-card')];
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

  const processSteps = [...document.querySelectorAll<HTMLElement>('.process-step')];

  if (processSteps.length && !motionPreference.matches && 'IntersectionObserver' in window
    && typeof Element.prototype.animate === 'function') {
    const pendingSteps = new Set(processSteps);
    const activeAnimations = new Set<Animation>();
    const releaseListeners = () => {
      if (!pendingSteps.size && !activeAnimations.size) {
        motionPreference.removeEventListener('change', onPreference);
        document.removeEventListener('visibilitychange', onVisibility);
      }
    };
    const settleAnimations = () => {
      activeAnimations.forEach((animation) => animation.cancel());
      activeAnimations.clear();
      releaseListeners();
    };
    const onPreference = () => {
      if (!motionPreference.matches) return;
      observer.disconnect();
      pendingSteps.clear();
      settleAnimations();
    };
    const onVisibility = () => { if (document.hidden) settleAnimations(); };
    const observer = new IntersectionObserver((entries) => {
      const visibleSteps = entries
        .filter((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.25)
        .map((entry) => entry.target as HTMLElement)
        .filter((step) => pendingSteps.has(step))
        .sort((a, b) => processSteps.indexOf(a) - processSteps.indexOf(b));

      visibleSteps.forEach((step, index) => {
        pendingSteps.delete(step);
        observer.unobserve(step);
        if (document.hidden || motionPreference.matches) return;
        const distance = window.matchMedia('(max-width: 850px)').matches ? 32 : 64;
        try {
          [...step.children].forEach((content) => {
            const animation = content.animate([
              { transform: `translateX(${distance}px)`, opacity: 0.2 },
              { transform: 'translateX(0)', opacity: 1 },
            ], {
              duration: 600, delay: Math.min(index, 2) * 100,
              easing: 'cubic-bezier(.16, 1, .3, 1)', fill: 'both',
            });
            activeAnimations.add(animation);
            const release = () => {
              animation.cancel();
              activeAnimations.delete(animation);
              releaseListeners();
            };
            void animation.finished.then(release, release);
          });
        } catch {
          // Keep every step readable if the animation API is unavailable at runtime.
          observer.disconnect();
          pendingSteps.clear();
          settleAnimations();
        }
      });
      if (!pendingSteps.size) observer.disconnect();
      releaseListeners();
    }, { threshold: 0.25, rootMargin: '0px 0px -32px 0px' });

    motionPreference.addEventListener('change', onPreference);
    document.addEventListener('visibilitychange', onVisibility);
    processSteps.forEach((step) => observer.observe(step));
  }

  if (serviceCards.length && !motionPreference.matches && 'IntersectionObserver' in window) {
    const pendingCards = new Set(serviceCards);
    const activeCards = new Set<HTMLElement>();
    const settleCard = (card: HTMLElement) => {
      card.classList.remove('service-card-tracing');
      card.style.removeProperty('--service-delay');
      activeCards.delete(card);
      if (!pendingCards.size && !activeCards.size) {
        motionPreference.removeEventListener('change', settleMotion);
      }
    };
    const settleMotion = () => {
      if (!motionPreference.matches) return;
      observer.disconnect();
      pendingCards.clear();
      activeCards.forEach(settleCard);
      motionPreference.removeEventListener('change', settleMotion);
    };
    const observer = new IntersectionObserver((entries) => {
      const visibleCards = entries
        .filter((entry) => entry.isIntersecting)
        .map((entry) => entry.target.closest<HTMLElement>('.service-card'))
        .filter((card): card is HTMLElement => !!card && pendingCards.has(card))
        .sort((a, b) => serviceCards.indexOf(a) - serviceCards.indexOf(b));

      visibleCards.forEach((card, index) => {
        pendingCards.delete(card);
        const heading = card.querySelector('.service-card-top');
        if (heading) observer.unobserve(heading);
        activeCards.add(card);
        card.style.setProperty('--service-delay', `${Math.min(index, 3) * 70}ms`);
        card.classList.add('service-card-tracing');
        card.querySelector('.service-card-top span')?.addEventListener('animationend', () => {
          settleCard(card);
        }, { once: true });
      });
      if (!pendingCards.size) observer.disconnect();
    }, { threshold: 0.5 });

    motionPreference.addEventListener('change', settleMotion);
    serviceCards.forEach((card) => {
      const heading = card.querySelector('.service-card-top');
      if (heading) observer.observe(heading);
    });
  }

  const contactForm = document.querySelector<HTMLFormElement>('.contact-form');

  if (contactForm) {
    const submitButton = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = submitButton?.querySelector<HTMLElement>('.submit-label');
    const formError = contactForm.querySelector<HTMLElement>('.form-error');
    const originalLabel = submitLabel?.textContent ?? '';
    let isSubmitting = false;

    contactForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (isSubmitting) return;

      isSubmitting = true;
      if (formError) formError.hidden = true;
      if (submitLabel) submitLabel.textContent = contactForm.dataset.sendingLabel ?? originalLabel;
      if (submitButton) submitButton.disabled = true;

      const body = new URLSearchParams();
      new FormData(contactForm).forEach((value, key) => {
        if (typeof value === 'string') body.append(key, value);
      });

      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });
        if (!response.ok) throw new Error(`Form submission failed: ${response.status}`);
        window.location.assign(contactForm.action);
      } catch {
        isSubmitting = false;
        if (submitButton) submitButton.disabled = false;
        if (submitLabel) submitLabel.textContent = originalLabel;
        if (formError) formError.hidden = false;
      }
    });

    window.addEventListener('pageshow', () => {
      isSubmitting = false;
      if (submitButton) submitButton.disabled = false;
      if (submitLabel) submitLabel.textContent = originalLabel;
    });

    if (contactForm.dataset.locale === 'es') {
      contactForm.addEventListener('invalid', (event) => {
        const field = event.target;
        if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;

        if (field.validity.valueMissing) {
          field.setCustomValidity('Completa este campo.');
        } else if (field instanceof HTMLInputElement && field.type === 'email' && field.validity.typeMismatch) {
          field.setCustomValidity('Introduce un correo electrónico válido.');
        }
      }, true);

      const clearValidationMessage = (event: Event) => {
        const field = event.target;
        if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement) {
          field.setCustomValidity('');
        }
      };

      contactForm.addEventListener('input', clearValidationMessage);
      contactForm.addEventListener('change', clearValidationMessage);
    }
  }
</script>
