---
import { copy, paths, type Locale } from '../lib/copy';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div>
      <a class="footer-brand" href={paths[locale].home}>Juana <span>&</span> Lola Digital</a>
      <p>{t.footer.line}</p>
    </div>
    <div class="footer-side">
      <a href={`${paths[locale].home}#contacto`}>{t.nav.contact} ↗</a>
      <small>© {new Date().getFullYear()} Juana & Lola Digital. {t.footer.rights}</small>
    </div>
  </div>
</footer>
