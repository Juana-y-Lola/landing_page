---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, paths, type Locale } from '../lib/copy';
import { getProjects, type PortfolioEntry } from '../lib/portfolio';

interface Props { locale: Locale; entry: PortfolioEntry }
const { locale, entry } = Astro.props;
const t = copy[locale];
const otherLocale = locale === 'es' ? 'en' : 'es';
const translations = await getProjects(otherLocale);
const counterpart = translations.find((item) => item.data.translationKey === entry.data.translationKey);
if (!counterpart) throw new Error(`Missing ${otherLocale} translation for ${entry.data.translationKey}`);
const alternatePaths = {
  es: locale === 'es' ? entry.data.detailLink : counterpart.data.detailLink,
  en: locale === 'en' ? entry.data.detailLink : counterpart.data.detailLink,
};
const { Content } = await render(entry);
---

<BaseLayout
  locale={locale}
  title={`${entry.data.name} | Juana & Lola Digital`}
  description={entry.data.description}
  canonicalPath={entry.data.detailLink}
  alternatePaths={alternatePaths}
>
  <main id="main-content" class="project-page">
    <section class="project-hero section-pad">
      <div class="shell">
        <a class="back-link" href={`${paths[locale].home}#proyectos`}><span aria-hidden="true">←</span> {t.detail.back}</a>
        <div class="project-intro">
          <div><p class="eyebrow"><span class="eyebrow-dot"></span>{entry.data.kind === 'concept' ? t.detail.concept : t.work.real} · {entry.data.category}</p><h1>{entry.data.name}</h1></div>
          <p>{entry.data.description}</p>
        </div>
        <div class="project-hero-image"><img src={entry.data.previewImage} width="1200" height="800" alt={entry.data.imageAlt} /></div>
      </div>
    </section>
    <section class="project-body section-pad">
      <div class="shell project-body-grid">
        <div class="project-aside"><p class="eyebrow"><span class="eyebrow-dot"></span>{t.detail.overview}</p><span aria-hidden="true">✳</span></div>
        <article class="prose"><Content />{entry.data.projectLink && <p><a class="text-link" href={entry.data.projectLink} rel="noopener noreferrer">{t.detail.visit}<span aria-hidden="true">↗</span></a></p>}</article>
      </div>
    </section>
    <section class="project-next section-pad"><div class="shell"><p>{t.detail.next}</p><a class="button button-dark" href={`${paths[locale].home}#contacto`}>{t.detail.nextAction}<span aria-hidden="true">↗</span></a></div></section>
  </main>
</BaseLayout>
